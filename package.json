{
  "name": "human-knowledge-model",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Human Knowledge Model website and env-configured Python Codex problem studio.",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "python scripts/build_site.py",
    "validate": "python scripts/validate_site.py",
    "start": "pnpm run build && python -m harness.server",
    "start:mock": "pnpm run build && python -m harness.server --mock",
    "lint:js": "node --check site/app.js && node --check site/harness.js",
    "test": "python -m unittest discover -s harness/tests -p \"test_*.py\"",
    "check": "pnpm run lint:js && pnpm run test && pnpm run build && pnpm run validate"
  },
  "dependencies": {},
  "engines": {
    "node": ">=18"
  }
}
