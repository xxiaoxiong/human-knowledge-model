# Copy this file to .env. The service reads it once when Python starts.
# Never commit .env or put these values in browser code.
HKM_HOST=127.0.0.1
HKM_PORT=4317

# Keep local for workstation use. A hosted container sets hosted and binds 0.0.0.0.
HKM_DEPLOYMENT_MODE=local

# Hosted mode only. Use the exact public HTTPS origin and a separate random
# access token of at least 32 characters. This is not the model API key.
HKM_PUBLIC_ORIGIN=
HKM_ACCESS_TOKEN=

# Optional writable runtime directory. Containers use /tmp/hkm-runtime.
HKM_RUNTIME_DIR=

# OpenAI Responses-compatible model provider used by the Codex Python SDK.
HKM_MODEL_PROVIDER_NAME=Your provider name
HKM_MODEL_BASE_URL=https://api.example.com/v1
HKM_MODEL_API_KEY=replace-with-your-api-key
HKM_MODEL_ID=replace-with-your-model-id

# Optional. Leave blank when a provider does not expose Codex reasoning controls.
HKM_MODEL_REASONING_EFFORT=

# Development only: use mock to return deterministic graph-grounded output.
HKM_AGENT_MODE=live
